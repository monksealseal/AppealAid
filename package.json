{
  "name": "appealaid",
  "version": "1.0.0",
  "description": "AppealAid - Insurance appeal management application",
  "main": "index.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "jest --runInBand",
    "test:e2e": "jest --config=./backend/tests/jest.e2e.config.js --runInBand",
    "test:watch": "jest --watch",
    "test:e2e:watch": "jest --config=./backend/tests/jest.e2e.config.js --watch",
    "test:response": "jest --config=./backend/tests/jest.e2e.config.js --testPathPattern=response"
  },
  "author": "AppealAid Team",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-tesseract-ocr": "^2.2.1",
    "pdf-parse": "^1.1.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "mochawesome": "^7.1.3",
    "nodemon": "^3.0.1",
    "selenium-webdriver": "^4.15.0",
    "supertest": "^6.3.3"
  }
}