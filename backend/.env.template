# Environment Template
# Copy this file to .env and fill in the values

# Node environment
NODE_ENV=production

# Server port
PORT=5000

# MongoDB connection string
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/appealaid?retryWrites=true&w=majority

# JWT settings
# Generate a secure random string using: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=30d

# File upload settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# Mock settings - set to false for production
USE_MOCK_DB=false
MOCK_MONGO=false

# CORS settings
# Replace with your frontend domain in production
CORS_ORIGIN=http://localhost:3000