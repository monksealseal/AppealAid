# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/appeal-aid
# Set to true to use mock data without MongoDB connection
MOCK_MONGO=false

# JWT Configuration for Authentication
JWT_SECRET=your_jwt_secret_key_here
TOKEN_EXPIRY=7d

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=app.log

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Claude API Configuration (Default values, user provides their own key)
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
CLAUDE_API_MODEL=claude-3-sonnet-20240229
CLAUDE_API_VERSION=2023-06-01

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_APPEAL_GENERATION=true

# Email Configuration (if adding email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password
# EMAIL_FROM=noreply@appealaid.com